<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.rem.body"
    android:versionCode="37" android:versionName="0.4.1-cloud">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <!-- Cloud access uses a private device credential; provider API keys stay on the server. -->
    <application android:label="雷姆" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <receiver android:name=".voice.ProvisionReceiver" android:exported="true" android:permission="android.permission.DUMP">
            <intent-filter><action android:name="com.rem.body.PROVISION" /></intent-filter>
        </receiver>
        <activity android:name=".RemActivity" android:exported="true"
            android:launchMode="singleTask" android:screenOrientation="portrait"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>

