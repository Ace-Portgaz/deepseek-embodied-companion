[Unit]
Description=Dafeiyu private Mandarin ONNX speech
After=local-fs.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=rem
Group=rem
WorkingDirectory=/opt/rem-voice/current/service
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=REM_VOICE_MODELS=/opt/rem-voice/current/models
Environment=REM_VOICE_LANGUAGE=zh
Environment=REM_VOICE_PROFILE=dafeiyu-zh-sparkle-v1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=1
ExecStart=/opt/rem-voice/venv/bin/python server.py
RuntimeDirectory=rem-voice
RuntimeDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10
MemoryMax=2800M
MemorySwapMax=128M
CPUQuota=150%
Nice=10
TasksMax=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
InaccessiblePaths=/opt/rem-cloud/runtime /var/lib/rem-cloud
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/rem-voice
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
