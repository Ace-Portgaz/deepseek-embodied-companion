[Unit]
Description=Rem Japanese voice companion
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=rem
Group=rem
WorkingDirectory=/opt/rem-cloud/build/server
Environment=PATH=/opt/rem-cloud/venv/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=REM_NATIVE=1
Environment=REM_TEST_BUDGET_FILE=/var/lib/rem-cloud/data/speech-test-budget.json
Environment=TZ=Asia/Shanghai
LoadCredential=rem_settings:/opt/rem-cloud/runtime/settings.json
LoadCredential=rem_credentials:/opt/rem-cloud/runtime/credentials.json
ExecStart=/opt/rem-cloud/venv/bin/python rem-entrypoint.py
Restart=on-failure
RestartSec=5
RuntimeDirectory=rem-cloud
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/rem-cloud /run/rem-cloud
MemoryMax=1500M
TasksMax=128
LimitNOFILE=4096
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
